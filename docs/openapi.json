    "/api/v1/checkout/quote": {
      "get": {
        "description": "Informative quote computed on the server. The charged total is recalculated when the transaction is created.",
        "operationId": "checkoutQuote",
        "parameters": [
          {
            "name": "cityCode",
            "required": true,
            "in": "query",
            "description": "Five-digit DIVIPOLA municipality code.",
            "schema": {
              "example": "05001"
            }
          },
          {
            "name": "quantity",
            "required": true,
            "in": "query",
            "schema": {
              "minimum": 1,
              "example": 1,
              "type": "integer"
            }
          },
          {
            "name": "productId",
            "required": true,
            "in": "query",
            "description": "Product id.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutQuote"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The resource does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "The request breaks a business rule.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Quote an order: product amount, service fee, delivery fee and total",
        "tags": [
          "Checkout"
        ]
      }
    },
    "/api/v1/customers": {
      "post": {
        "description": "Always creates a new customer (there is no lookup by email). The response masks the personal data.",
        "operationId": "customersCreate",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Client-generated UUID. Repeating it with the same body returns the stored response with `Idempotent-Replayed: true`; with another body, 409 IDEMPOTENCY_KEY_CONFLICT.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "headers": {
              "Location": {
                "description": "URL of the new customer.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.\n\nInvalid request parameters.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with the current state or a previous request.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Create the customer of a checkout",
        "tags": [
          "Customers"
        ]
      }
    },
    "/api/v1/customers/{customerId}": {
      "get": {
        "operationId": "customersDetail",
        "parameters": [
          {
            "name": "customerId",
            "required": true,
            "in": "path",
            "description": "Customer id.",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The resource does not exist.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Get a customer with its personal data masked",
        "tags": [
          "Customers"
        ]
      }
    }
  },
  "info": {
    "title": "Tech Store Checkout API",
    "description": "Catalog, delivery coverage and checkout of a tech accessories store. Errors follow RFC 9457 Problem Details.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/",
      "description": "Same origin (CloudFront routes /api/* to the API)"
    }
  ],
  "components": {
    "schemas": {
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "productId"
          },
          "message": {
            "type": "string",
            "example": "Must be a valid UUID."
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "/problems/product-not-found"
          },
          "title": {
            "type": "string",
            "example": "Not Found"
          },
          "status": {
            "type": "number",
            "example": 404
          },
          "detail": {
            "type": "string",
            "example": "The product does not exist."
          },
          "instance": {
            "type": "string",
            "example": "/api/v1/products/7d094266-0b4e-4789-9522-96e1cd7ffa61"
          },
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code.",
            "example": "PRODUCT_NOT_FOUND"
          },
          "traceId": {
            "type": "string",
            "description": "Request id, also returned in the X-Request-Id header."
          },
          "context": {
            "type": "object",
            "description": "Extra data about the error.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "errors": {
            "description": "Invalid fields (400 only).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "traceId"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "description": "Deployed application version.",
            "example": "0.1.0"
          },
          "time": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-27T15:00:00.000Z"
          }
        },
        "required": [
          "status",
          "version",
          "time"
        ]
      },
      "Money": {
        "type": "object",
        "properties": {
          "amountInCents": {
            "type": "number",
            "description": "Amount in cents (integer).",
            "example": 3990000
          },
          "currency": {
            "type": "string",
            "enum": [
              "COP"
            ],
            "example": "COP"
          }
        },
        "required": [
          "amountInCents",
          "currency"
        ]
      },
      "Stock": {
        "type": "object",
        "properties": {
          "available": {
            "type": "number",
            "description": "Units that can be bought now.",
            "example": 12
          },
          "status": {
            "type": "string",
            "enum": [
              "IN_STOCK",
              "LOW_STOCK",
              "OUT_OF_STOCK"
            ],
            "example": "IN_STOCK"
          }
        },
        "required": [
          "available",
          "status"
        ]
      },
      "ImageSource": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "image/avif"
          },
          "srcSet": {
            "type": "string",
            "example": "/images/products/tec-cbl-usbc-320.avif 320w, /images/products/tec-cbl-usbc-640.avif 640w, /images/products/tec-cbl-usbc-960.avif 960w"
          }
        },
        "required": [
          "type",
          "srcSet"
        ]
      },
      "Image": {
        "type": "object",
        "properties": {
          "alt": {
            "type": "string",
            "example": "Cable USB-C trenzado gris enrollado"
          },
          "width": {
            "type": "number",
            "example": 640
          },
          "height": {
            "type": "number",
            "example": 640
          },
          "src": {
            "type": "string",
            "description": "JPEG fallback, 640 px wide.",
            "example": "/images/products/tec-cbl-usbc-640.jpg"
          },
          "sources": {
            "description": "Modern formats for <picture>.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageSource"
            }
          }
        },
        "required": [
          "alt",
          "width",
          "height",
          "src",
          "sources"
        ]
      },
      "ProductSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "7d094266-0b4e-4789-9522-96e1cd7ffa60"
          },
          "sku": {
            "type": "string",
            "example": "TEC-CBL-USBC"
          },
          "name": {
            "type": "string",
            "example": "Cable USB-C a USB-C 2 m (100 W)"
          },
          "shortDescription": {
            "type": "string",
            "example": "Carga rápida de hasta 100 W y transferencia de datos USB 2.0."
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "shortDescription",
          "price",
          "stock",
          "image"
        ]
      },
      "ListMeta": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "example": 10
          }
        },
        "required": [
          "count"
        ]
      },
      "ProductList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ProductDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "7d094266-0b4e-4789-9522-96e1cd7ffa60"
          },
          "sku": {
            "type": "string",
            "example": "TEC-CBL-USBC"
          },
          "name": {
            "type": "string",
            "example": "Cable USB-C a USB-C 2 m (100 W)"
          },
          "shortDescription": {
            "type": "string",
            "example": "Carga rápida de hasta 100 W y transferencia de datos USB 2.0."
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "stock": {
            "$ref": "#/components/schemas/Stock"
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          },
          "description": {
            "type": "string"
          },
          "weightGrams": {
            "type": "number",
            "description": "Shipping weight.",
            "example": 150
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          },
          "maxUnitsPerOrder": {
            "type": "number",
            "description": "min(available stock, units allowed per order).",
            "example": 5
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "shortDescription",
          "price",
          "stock",
          "image",
          "description",
          "weightGrams",
          "images",
          "maxUnitsPerOrder"
        ]
      },
      "ProductStock": {
        "type": "object",
        "properties": {
          "available": {
            "type": "number",
            "description": "Units that can be bought now.",
            "example": 12
          },
          "status": {
            "type": "string",
            "enum": [
              "IN_STOCK",
              "LOW_STOCK",
              "OUT_OF_STOCK"
            ],
            "example": "IN_STOCK"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "available",
          "status",
          "productId",
          "updatedAt"
        ]
      },
      "Department": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Two-digit DIVIPOLA department code.",
            "example": "05"
          },
          "name": {
            "type": "string",
            "example": "Antioquia"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "DepartmentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Department"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "City": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Five-digit DIVIPOLA municipality code.",
            "example": "05001"
          },
          "name": {
            "type": "string",
            "example": "Medellín"
          },
          "zone": {
            "type": "string",
            "enum": [
              "LOCAL",
              "METRO",
              "NATIONAL_MAIN",
              "NATIONAL_REGIONAL",
              "SPECIAL_ROUTE"
            ],
            "description": "Delivery zone used to price shipping."
          }
        },
        "required": [
          "code",
          "name",
          "zone"
        ]
      },
      "CityList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/City"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ListMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "BusinessDaysRange": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number",
            "example": 2
          },
          "max": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "min",
          "max"
        ]
      },
      "DeliveryQuote": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "enum": [
              "LOCAL",
              "METRO",
              "NATIONAL_MAIN",
              "NATIONAL_REGIONAL",
              "SPECIAL_ROUTE"
            ],
            "example": "NATIONAL_MAIN"
          },
          "billableWeightKg": {
            "type": "number",
            "description": "Total weight rounded up to whole kilograms.",
            "example": 4
          },
          "freeShippingApplied": {
            "type": "boolean",
            "example": false
          },
          "freeShippingThreshold": {
            "description": "Product amount from which shipping is free.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "estimatedBusinessDays": {
            "description": "Estimated delivery, in business days.",
            "allOf": [
              {
                "$ref": "#/components/schemas/BusinessDaysRange"
              }
            ]
          }
        },
        "required": [
          "zone",
          "billableWeightKg",
          "freeShippingApplied",
          "freeShippingThreshold",
          "estimatedBusinessDays"
        ]
      },
      "CheckoutQuote": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "example": 1
          },
          "unitPrice": {
            "$ref": "#/components/schemas/Money"
          },
          "productAmount": {
            "description": "unitPrice × quantity.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "serviceFee": {
            "description": "Fixed fee per order.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "deliveryFee": {
            "description": "Zero when free shipping applies.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "total": {
            "description": "productAmount + serviceFee + deliveryFee.",
            "allOf": [
              {
                "$ref": "#/components/schemas/Money"
              }
            ]
          },
          "delivery": {
            "$ref": "#/components/schemas/DeliveryQuote"
          },
          "calculatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "productId",
          "quantity",
          "unitPrice",
          "productAmount",
          "serviceFee",
          "deliveryFee",
          "total",
          "delivery",
          "calculatedAt"
        ]
      },
      "CreateCustomerRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "description": "3 to 80 characters: letters (accents and ñ included), spaces, apostrophes, hyphens and dots; at least two words.",
            "example": "Ana María Gómez"
          },
          "email": {
            "type": "string",
            "description": "Up to 254 characters; stored in lower case.",
            "example": "ana.gomez@example.com"
          },
          "phone": {
            "type": "string",
            "description": "10 digits starting with 3 (mobile) or 60 (landline); +57, spaces and hyphens are accepted.",
            "example": "3001234567"
          },
          "legalIdType": {
            "type": "string",
            "enum": [
              "CC",
              "CE",
              "NIT",
              "PP"
            ],
            "example": "CC"
          },
          "legalId": {
            "type": "string",
            "description": "CC: 5-10 digits; CE: 6-10 letters or digits; NIT: 9 digits and an optional check digit; PP: 6-12 letters or digits.",
            "example": "1020304050"
          }
        },
        "required": [
          "fullName",
          "email",
          "phone",
          "legalIdType",
          "legalId"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "2f9d4c1a-7b3e-4d5f-8a6b-9c0d1e2f3a4b"
          },
          "fullName": {
            "type": "string",
            "example": "Ana M. G."
          },
          "email": {
            "type": "string",
            "example": "a***@example.com"
          },
          "phone": {
            "type": "string",
            "example": "******4567"
          },
          "legalIdType": {
            "type": "string",
            "enum": [
              "CC",
              "CE",
              "NIT",
              "PP"
            ],
            "example": "CC"
          },
          "legalId": {
            "type": "string",
            "example": "******4050"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-24T20:15:00.000Z"
          }
        },
        "description": "Customer with its personal data masked.",
        "required": [
          "id",
          "fullName",
          "email",
          "phone",
          "legalIdType",
          "legalId",
          "createdAt"
        ]
      }
    }
  }
}
