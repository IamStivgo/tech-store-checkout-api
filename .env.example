APP_ENV=local
APP_VERSION=0.0.0-local
LOG_LEVEL=debug
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
TABLE_PRODUCTS=checkout-app-local-products
TABLE_CUSTOMERS=checkout-app-local-customers
TABLE_TRANSACTIONS=checkout-app-local-transactions
TABLE_DELIVERIES=checkout-app-local-deliveries
TABLE_IDEMPOTENCY=checkout-app-local-idempotency-keys
LOW_STOCK_THRESHOLD=3
MAX_UNITS_PER_ORDER=5
# Payment provider: `fake` decides the result from the card token (tok_fake_approved_*, …).
# For the sandbox use `http` with the values from the exercise (never commit them).
PAYMENT_PROVIDER=fake
# PAYMENT_API_BASE_URL=https://<provider-sandbox-host>/v1
# PAYMENT_PUBLIC_KEY=
# PAYMENT_PRIVATE_KEY=
# PAYMENT_INTEGRITY_SECRET=
