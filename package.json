{
  "name": "tech-store-checkout-api",
  "version": "0.0.0",
  "private": true,
  "description": "Checkout API for a tech accessories store: catalog, delivery pricing, customers, transactions and card payments.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "build:lambda": "webpack --config webpack.lambda.config.mjs",
    "package:lambda": "npm run build:lambda && cd dist-lambda && rm -f ../dist-lambda.zip && zip -qr -X ../dist-lambda.zip lambda.js reconcile.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\" | pino-pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:deps": "depcruise src test --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:create-tables": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/create-local-tables.ts",
    "seed": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/seed.ts",
    "build:api-docs": "node -r ts-node/register/transpile-only scripts/build-api-docs.ts",
    "openapi:export": "node -r ts-node/register/transpile-only scripts/export-openapi.ts",
    "coverage:build": "node -r ts-node/register/transpile-only scripts/build-coverage-data.ts && prettier --write src/modules/coverage/infrastructure/coverage-data.json",
    "test": "jest --coverage",
    "test:artifacts": "node --test \"test/bundle/*.test.mjs\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/client-ssm": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@types/aws-lambda": "^8.10.163",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "swagger-ui-dist": "^5.33.0",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  }
}
